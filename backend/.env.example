# Провайдер LLM:
#   gemini    — безкоштовно, ключ: https://aistudio.google.com/apikey
#   anthropic — платно (Claude), ключ: https://console.anthropic.com
#   mock      — заглушка без мережі й ключа
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Порожньо = модель за замовчуванням (gemini-3.8-flash / claude-opus-5-5).
# Якщо впираєтесь у безкоштовний ліміт Gemini, спробуйте gemini-3.5-flash-lite
LLM_MODEL=

LLM_TIMEOUT_S=15
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=20
# Домени фронтенду через кому (CORS, NFR-6)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
